{
  "paths": {
    "base_cache_dir": "~/.mlx-cache",
    "mlx_cache_dir": "~/.mlx-cache/mlx",
    "models_dir": "~/.mlx-cache/models",
    "hf_home": "~/.mlx-cache/huggingface",
    "transformers_cache": "~/.mlx-cache/transformers"
  },
  "environment_variables": {
    "MLX_CACHE_DIR": "~/.mlx-cache/mlx",
    "MLX_MODELS_DIR": "~/.mlx-cache/models",
    "HF_HOME": "~/.mlx-cache/huggingface",
    "TRANSFORMERS_CACHE": "~/.mlx-cache/transformers",
    "OMP_NUM_THREADS": "8",
    "MLX_MEMORY_POOL": "1"
  },
  "model_categories": ["tiny", "small", "medium", "large", "code"],
  "performance": {
    "omp_num_threads": 8,
    "mlx_memory_pool": true,
    "performance_logging": true,
    "max_cache_size_gb": 50
  },
  "defaults": {
    "default_model": null,
    "preferred_quantization": "4bit",
    "auto_cleanup": true
  }
}