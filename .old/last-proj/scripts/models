#!/usr/bin/env python3
"""
ehAye Local Model Management Entry Point
Provides model download, installation, and management
"""

if __name__ == "__main__":
    try:
        from ehaye.cli.model_cli import main
        main()
    except ImportError as e:
        print(f"Error: Cannot import ehaye modules: {e}")
        print("Make sure you're in the correct virtual environment and ehaye is installed.")
        print("Run: pip install -e .")
        exit(1)
    except Exception as e:
        print(f"Fatal error: {e}")
        exit(1)