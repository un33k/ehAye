#!/usr/bin/env python3
"""
Ollama Launch Script
Quick launcher for Ollama with specified models
"""

import sys
import subprocess
import time
from pathlib import Path

def check_ollama():
    """Check if Ollama is running."""
    try:
        result = subprocess.run(
            ["ollama", "list"], 
            capture_output=True, 
            text=True, 
            timeout=5
        )
        return result.returncode == 0
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return False

def start_ollama_service():
    """Start Ollama service if not running."""
    if check_ollama():
        print("✅ Ollama is already running")
        return True
    
    print("🚀 Starting Ollama service...")
    try:
        # Try to start via brew services
        result = subprocess.run(
            ["brew", "services", "start", "ollama"],
            capture_output=True,
            text=True,
            timeout=10
        )
        
        if result.returncode == 0:
            # Wait for service to start
            for _ in range(10):
                time.sleep(1)
                if check_ollama():
                    print("✅ Ollama service started")
                    return True
            
        print("⚠️  Failed to start via brew services, trying direct launch...")
        # Try direct launch in background
        subprocess.Popen(
            ["ollama", "serve"], 
            stdout=subprocess.DEVNULL, 
            stderr=subprocess.DEVNULL
        )
        
        # Wait for service to start
        for _ in range(10):
            time.sleep(1)
            if check_ollama():
                print("✅ Ollama service started")
                return True
        
        print("❌ Failed to start Ollama service")
        return False
        
    except Exception as e:
        print(f"❌ Error starting Ollama: {e}")
        return False

def list_models():
    """List available models."""
    try:
        result = subprocess.run(
            ["ollama", "list"],
            capture_output=True,
            text=True,
            timeout=10
        )
        
        if result.returncode == 0:
            print("📦 Available Models:")
            print(result.stdout)
        else:
            print("❌ Failed to list models")
            
    except Exception as e:
        print(f"❌ Error listing models: {e}")

def run_model(model_name):
    """Run a model interactively."""
    print(f"🤖 Starting chat with {model_name}...")
    print("Type 'exit' or press Ctrl+C to quit")
    print("-" * 50)
    
    try:
        subprocess.run(["ollama", "run", model_name])
    except KeyboardInterrupt:
        print("\n👋 Chat session ended")
    except Exception as e:
        print(f"❌ Error running model: {e}")

def pull_model(model_name):
    """Download a model."""
    print(f"⬇️  Downloading {model_name}...")
    try:
        subprocess.run(["ollama", "pull", model_name])
        print(f"✅ Successfully downloaded {model_name}")
    except Exception as e:
        print(f"❌ Error downloading model: {e}")

def main():
    """Main function."""
    if len(sys.argv) < 2:
        print("🦙 Ollama Quick Launch")
        print("=" * 30)
        print()
        print("Usage:")
        print("  ./scripts/ollama-launch list              # List models")
        print("  ./scripts/ollama-launch pull <model>      # Download model")
        print("  ./scripts/ollama-launch run <model>       # Run model")
        print("  ./scripts/ollama-launch start             # Start service")
        print()
        print("Examples:")
        print("  ./scripts/ollama-launch pull phi3")
        print("  ./scripts/ollama-launch run phi3")
        print("  ./scripts/ollama-launch list")
        return

    command = sys.argv[1]
    
    # Ensure Ollama service is running for most commands
    if command in ["list", "pull", "run"]:
        if not start_ollama_service():
            sys.exit(1)
    
    if command == "start":
        start_ollama_service()
    elif command == "list":
        list_models()
    elif command == "pull":
        if len(sys.argv) < 3:
            print("❌ Please specify a model name")
            print("Example: ./scripts/ollama-launch pull phi3")
            sys.exit(1)
        pull_model(sys.argv[2])
    elif command == "run":
        if len(sys.argv) < 3:
            print("❌ Please specify a model name")
            print("Example: ./scripts/ollama-launch run phi3")
            sys.exit(1)
        run_model(sys.argv[2])
    else:
        print(f"❌ Unknown command: {command}")
        print("Use 'list', 'pull', 'run', or 'start'")
        sys.exit(1)

if __name__ == "__main__":
    main()