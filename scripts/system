#!/usr/bin/env python3
"""
ehAye System Management Entry Point
Provides system diagnostics and management
"""

if __name__ == "__main__":
    try:
        from ali.cli.system_cli import main
        main()
    except ImportError as e:
        print(f"Error: Cannot import ali modules: {e}")
        print("Make sure you're in the correct virtual environment and ali is installed.")
        print("Run: pip install -e .")
        exit(1)
    except Exception as e:
        print(f"Fatal error: {e}")
        exit(1)