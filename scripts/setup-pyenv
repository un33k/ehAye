#!/usr/bin/env bash
set -euo pipefail

# ============================================================================
# ehAye pyenv Virtual Environment Setup Script
# 
# Creates an isolated pyenv virtual environment for ehAye-Local
# Useful for manual setup or when working with multiple projects
# ============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
PYTHON_VERSION="${PYTHON_VERSION:-3.11.9}"
VENV_NAME="${VENV_NAME:-ehaye-local-$(basename "$PROJECT_DIR")}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log_info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

log_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

log_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

log_error() {
    echo -e "${RED}❌ $1${NC}"
}

# Check if pyenv is installed
check_pyenv() {
    if ! command -v pyenv >/dev/null 2>&1; then
        log_error "pyenv is not installed"
        log_info "Install with: brew install pyenv pyenv-virtualenv"
        log_info "Or run the full bootstrap script: ./bootstrap.sh"
        exit 1
    fi
    
    log_success "pyenv is available"
}

# Install Python version if needed
setup_python() {
    log_info "Setting up Python $PYTHON_VERSION..."
    
    if pyenv versions --bare | grep -q "^$PYTHON_VERSION$"; then
        log_success "Python $PYTHON_VERSION already installed"
    else
        log_info "Installing Python $PYTHON_VERSION..."
        if ! pyenv install "$PYTHON_VERSION"; then
            log_error "Failed to install Python $PYTHON_VERSION"
            log_info "Available versions: pyenv install --list"
            exit 1
        fi
        log_success "Python $PYTHON_VERSION installed"
    fi
}

# Create virtual environment
create_venv() {
    log_info "Creating virtual environment: $VENV_NAME"
    
    # Check if virtualenv plugin is available
    if ! pyenv commands | grep -q virtualenv; then
        log_error "pyenv-virtualenv is not installed"
        log_info "Install with: brew install pyenv-virtualenv"
        exit 1
    fi
    
    # Remove existing virtualenv if it exists
    if pyenv virtualenvs --bare | grep -q "^$VENV_NAME$"; then
        log_warning "Virtual environment $VENV_NAME already exists"
        read -p "Remove and recreate? (y/N): " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            pyenv virtualenv-delete -f "$VENV_NAME"
            log_info "Removed existing virtual environment"
        else
            log_info "Using existing virtual environment"
            return 0
        fi
    fi
    
    # Create new virtualenv
    pyenv virtualenv "$PYTHON_VERSION" "$VENV_NAME"
    log_success "Created virtual environment: $VENV_NAME"
}

# Set up .venv symlink
setup_symlink() {
    cd "$PROJECT_DIR"
    
    log_info "Setting up .venv symlink..."
    
    # Remove existing .venv if it exists
    if [[ -e ".venv" ]]; then
        rm -rf .venv
    fi
    
    # Create symlink to pyenv virtualenv
    local venv_path="$(pyenv root)/versions/$VENV_NAME"
    ln -sf "$venv_path" .venv
    
    log_success "Created .venv symlink"
}

# Set local Python version
set_local_python() {
    cd "$PROJECT_DIR"
    
    log_info "Setting local Python version..."
    pyenv local "$PYTHON_VERSION"
    
    log_success "Set local Python version to $PYTHON_VERSION"
}

# Install project dependencies
install_deps() {
    cd "$PROJECT_DIR"
    
    log_info "Installing project dependencies..."
    
    # Activate virtual environment
    source .venv/bin/activate
    
    # Upgrade pip
    pip install --upgrade pip
    
    # Install project in development mode
    pip install -e .
    
    log_success "Dependencies installed"
}

# Main function
main() {
    echo "🐍 ehAye pyenv Virtual Environment Setup"
    echo "========================================"
    echo ""
    echo "Python Version: $PYTHON_VERSION"
    echo "Virtual Env:    $VENV_NAME"
    echo "Project Dir:    $PROJECT_DIR"
    echo ""
    
    # Setup steps
    check_pyenv
    setup_python
    create_venv
    setup_symlink
    set_local_python
    install_deps
    
    echo ""
    echo "🎉 Virtual environment setup completed!"
    echo ""
    echo "Next steps:"
    echo "  1. Activate: source .venv/bin/activate"
    echo "  2. Verify: ali --help"
    echo "  3. Test: ali sys info"
    echo ""
    echo "Environment details:"
    echo "  • Python version: $PYTHON_VERSION"
    echo "  • Virtual environment: $VENV_NAME"
    echo "  • Location: $(pyenv root)/versions/$VENV_NAME"
    echo "  • Symlink: $PROJECT_DIR/.venv"
    echo ""
    echo "To remove this environment:"
    echo "  pyenv virtualenv-delete $VENV_NAME"
}

# Handle interruption
trap 'log_warning "Setup interrupted"; exit 1' INT

# Run main function
main "$@"